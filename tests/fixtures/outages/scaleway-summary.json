27:40.569+02:00", "shortlink": "https://stspg.io/6r3ytkncvf24", "scheduled_for": null, "scheduled_until": null, "components": [{"id": "kqx4bmbccs22", "name": "Excellence", "status": "degraded_performance"}], "incident_updates": [{"status": "identified", "body": "Due to a high volume of requests, it may be difficult to reach our teams by phone.\nIf needed, we invite you to contact us directly by submitting a ticket so that your request can be processed as quickly as possible.\nThank you for your understanding.\n\nEn raison d’un nombre élevé de demandes, il peut être difficile de joindre nos équipes par téléphone.\nAu besoin, nous vous invitons à nous contacter directement par ticket afin que votre demande soit prise en charge dans les meilleurs délais.\nMerci de votre compréhension.", "created_at": "2026-10-08T18:27:40.698+02:00"}]}, {"id": "plhwpkrc8qqh", "name": "[Container Registry] Increase in 5xx errors on fr-par Container Registry", "status": "investigating", "impact": "minor", "created_at": "2026-10-08T10:27:20.027+02:00", "updated_at": "2026-10-08T10:56:47.976+02:00", "monitoring_at": null, "resolved_at": null, "started_at": "2026-10-08T10:27:20.019+02:00", "shortlink": "https://stspg.io/kdv5ytj12rjq", "scheduled_for": null, "scheduled_until": null, "components": [{"id": "62wqmwd0z8jf", "name": "fr-par-1", "status": "operational"}, {"id": "f7swcx2sw17z", "name": "fr-par-2", "status": "operational"}, {"id": "d64dwyz4v703", "name": "fr-par-3", "status": "operational"}, {"id": "7zlc124f4x9c", "name": "Container Registry", "status": "degraded_performance"}, {"id": "vtwqflzktb07", "name": "Jobs", "status": "operational"}, {"id": "cvx0lc6bxrf0", "name": "Kafka", "status": "degraded_performance"}, {"id": "q2mhk4wg0gmk", "name": "Serverless Container", "status": "degraded_performance"}, {"id": "6vfksf35tcnn", "name": "Serverless Functions", "status": "degraded_performance"}, {"id": "rvy4m818m4kg", "name": "Clusters for Apache Spark™", "status": "degraded_performance"}], "incident_updates": [{"status": "investigating", "body": "We added other impacted products and we are still investigating.", "created_at": "2026-10-08T10:54:35.805+02:00"}]}, {"id": "87ycqszz6xpz", "name": "[Key Manager] - it-mil - api unavailable", "status": "identified", "impact": "minor", "created_at": "2026-10-07T15:24:24.176+02:00", "updated_at": "2026-10-07T15:52:41.689+02:00", "monitoring_at": null, "resolved_at": null, "started_at": "2026-10-07T15:24:24.164+02:00", "shortlink": "https://stspg.io/sxr9mhd149ml", "scheduled_for": null, "scheduled_until": null, "components": [{"id": "dd0bwyb3kw9z", "name": "Secret Manager", "status": "degraded_performance"}], "incident_updates": [{"status": "identified", "body": "incident has been mitigated, we are implementing a long-term solution", "created_at": "2026-10-07T15:52:41.686+02:00"}]}, {"id": "fmscp9jt7gmg", "name": "[Generative APIs] - [fr-par] - glm-5.2 service instabilities", "status": "investigating", "impact": "minor", "created_at": "2026-10-06T17:02:55.030+02:00", "updated_at": "2026-10-06T17:02:55.139+02:00", "monitoring_at": null, "resolved_at": null, "started_at": "2026-10-06T17:02:55.020+02:00", "shortlink": "https://stspg.io/mlk8jgpg43mx", "scheduled_for": null, "scheduled_until": null, "components": [{"id": "yl8gl787xwyj", "name": "Generative API", "status": "degraded_performance"}], "incident_updates": [{"status": "investigating", "body": "[15h00 utc+2]\nWe are experiencing instabilities with a critical part of the glm-5.2 model infrastructure, working actively on the mitigation", "created_at": "2026-10-06T17:02:55.136+02:00"}]}], "scheduled_maintenances": [{"id": "yv711z4ph00v", "name": "[Serverless Functions/Containers] - [it-mil, nl-ams, pl-waw] Network reconfiguration", "status": "scheduled", "impact": "maintenance", "created_at": "2026-10-08T15:49:43.340+02:00", "updated_at": "2026-10-08T15:51:24.618+02:00", "monitoring_at": null, "resolved_at": null, "started_at": "2026-10-08T15:49:43.329+02:00", "shortlink": "https://stspg.io/ryrrqtvd3p1z", "scheduled_for": "2026-10-19T10:00:00.000+02:00", "scheduled_until": "2026-10-19T12:00:00.000+02:00", "components": [{"id": "q2mhk4wg0gmk", "name": "Serverless Container", "status": "degraded_performance"}, {"id": "6vfksf35tcnn", "name": "Serverless Functions", "status": "degraded_performance"}], "incident_updates": [{"status": "scheduled", "body": "On 2026-10-19, between 08:00 AM UTC and 10:00 AM UTC, we will perform a mandatory network update on the Serverless Functions and Containers infrastructure. This change aims to improve overall networking performance.\n\nDuring that period, the network of each node in our infrastructure will be reconfigured sequentially. For each node, during maximum 1 minute:\n\n- functions/containers located on the node might temporarily lose network connectivity\n- calling functions/containers might return 5xx errors (or timeouts)\n\nWe apologize about any inconvenience.", "created_at": "2026-10-08T15:49:43.424+02:00"}]}, {"id": "jzchqm4j50h9", "name": "[Serverless Functions/Containers] - [fr-par] Network reconfiguration", "status": "scheduled", "impact": "maintenance", "created_at": "2026-10-08T15:52:51.248+02:00", "updated_at": "2026-10-08T15:55:36.183+02:00", "monitoring_at": null, "resolved_at": null, "started_at": "2026-10-20T10:00:51.344+02:00", "shortlink": "https://stspg.io/y63zswkql4gn", "scheduled_for": "2026-10-20T10:00:00.000+02:00", "scheduled_until": "2026-10-20T12:00:00.000+02:00", "components": [{"id": "q2mhk4wg0gmk", "name": "Serverless Container", "status": "degraded_performance"}, {"id": "6vfksf35tcnn", "name": "Serverless Functions", "status": "degraded_performance"}], "incident_updates": [{"status": "scheduled", "body": "On 2026-10-20, between 08:00 AM UTC and 10:00 AM UTC, we will perform a mandatory network update on the Serverless Functions and Containers infrastructure. This change aims to improve overall networking performance.\n\nDuring that period, the network of each node in our infrastructure will be reconfigured sequentially. For each node, during maximum 1 minute:\n\n- functions/containers located on the node might temporarily lose network connectivity\n- calling functions/containers might return 5xx errors (or timeouts)\n\nWe apologize about any inconvenience.", "created_at": "2026-10-08T15:52:51.344+02:00"}]}, {"id": "6m5x9f9dy4tf", "name": "[DEDIRACK][DC1] Changes to access control during building works", "status": "in_progress", "impact": "maintenance", "created_at": "2026-09-14T14:43:38.888+02:00", "updated_at": "2026-09-15T09:00:07.812+02:00", "monitoring_at": null, "resolved_at": null, "started_at": "2026-09-14T14:43:38.872+02:00", "shortlink": "https://stspg.io/z245bpsjvzg0", "scheduled_for": "2026-09-15T09:00:00.000+02:00", "scheduled_until": "2026-11-16T08:00:00.000+01:00", "components": [{"id": "1h8tzfl2zxyy", "name": "DC1", "status": "under_maintenance"}, {"id": "95p0df50ydqd", "name": "Dedirack", "status": "under_maintenance"}], "incident_updates": [{"status": "in_progress", "body": "Scheduled maintenance is currently in progress. We will provide updates as necessary.", "created_at": "2026-09-15T09:00:07.803+02:00"}]}]}