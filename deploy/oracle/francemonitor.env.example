# deploy/oracle/francemonitor.env.example — NOMS de toutes les variables lues
# à l'exécution par l'API Node, le relais AIS et le worker radar sur la VM.
#
# AUCUNE VALEUR RÉELLE ICI. Ce fichier ne contient que des noms et des
# commentaires — jamais un secret. Voir docs/deployment-oracle.md §c pour la
# procédure de migration des vraies valeurs (vercel env pull, railway
# variables, clé Render, etc.) vers le fichier réel sur la VM :
#
#   /etc/francemonitor/francemonitor.env   (root:fm, 640, format CLE=valeur)
#
# Ce fichier est chargé par systemd via `EnvironmentFile=` dans les unités
# deploy/oracle/systemd/*.service. Les constantes propres à la VM qui NE
# DOIVENT PAS être écrasées par une valeur héritée de Vercel/Railway/Render
# (chemins locaux, ports, URLs internes) sont fixées directement dans les
# unités systemd via `Environment=` (qui prime sur EnvironmentFile) — elles
# sont listées ici en commentaire, pour information, mais ne PAS les définir
# dans le fichier réel sauf besoin explicite de les surcharger.
#
# Liste obtenue via :
#   grep -rhoE "process\.env(\.|\[')[A-Z_0-9]+" api ais-relay.js
#   grep -rhoE "os\.(getenv|environ)\(?[\"']([A-Z_0-9]+)" services/radar-worker/*.py
#   + variables radar de services/radar-worker/Dockerfile et railway.toml


# ════════════════════════════════════════════════════════════
# OBLIGATOIRES — les services concernés ne fonctionnent pas sans ces valeurs.
# ════════════════════════════════════════════════════════════

# Upstash Redis — cache, verrou d'ingestion, historique de situation.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neon Postgres — table news_items (90 j de rétention). Sans elle, /api/news
# répond 503 (pas de crash).
DATABASE_URL=

# Secret partagé pour déclencher l'ingestion news ET le rafraîchissement des
# séries carburants (les deux timers systemd fm-ingest-news / fm-fuel-series
# envoient Authorization: Bearer $CRON_SECRET — voir leurs .service).
CRON_SECRET=

# RTE — Ecowatt (signal officiel), Eco2mix, indisponibilités nucléaires.
RTE_CLIENT_ID=
RTE_CLIENT_SECRET=
# RTE_API_VERSION=v7    # défaut v7, override ponctuel si RTE change de version

# Météo-France : alertes vigilance (api/environment/vigilance).
METEO_FRANCE_API_KEY=

# Météo-France DPRadar — worker radar (fm-radar.service).
METEO_FRANCE_RADAR_API_KEY=
# Secret partagé exigé par POST /refresh et /publish du worker radar
# (Authorization: Bearer ...). Doit être IDENTIQUE à secrets.RADAR_WORKER_TOKEN
# côté GitHub (utilisé par .github/workflows/radar-refresh.yml).
RADAR_WORKER_TOKEN=

# URL du manifeste radar consommée par l'API (api/_handlers/fire-observations/
# radar-2d.js et radar-column.js). Sur la VM, API et worker radar tournent en
# local : pointer en interne évite un aller-retour par Cloudflare/Caddy et une
# dépendance circulaire sur le domaine public.
METEO_FRANCE_RADAR_MANIFEST_URL=http://127.0.0.1:8091/manifest.json

# TomTom — trafic routier (incidents, flow, tuiles).
TOMTOM_API_KEY=

# AISStream.io — upstream du relais AIS local (fm-relay.service).
AISSTREAM_API_KEY=
# AISSTREAM_UPSTREAM_URL=wss://stream.aisstream.io/v0/stream   # défaut, override rare


# ════════════════════════════════════════════════════════════
# CONSTANTES VM — déjà fixées dans les unités systemd (Environment=).
# Ne PAS les définir ici sauf pour surcharger volontairement une unité.
# ════════════════════════════════════════════════════════════

# RADAR_STORAGE_DIR=/var/lib/francemonitor/radar          (fm-radar.service)
# RADAR_PUBLIC_BASE_URL=https://www.francemonitor.com/radar (fm-radar.service)
# RELAY_PORT=8090                                           (fm-relay.service)
# ECCODES_DEFINITION_PATH=.../services/radar-worker/eccodes-definitions (fm-radar.service)
# NODE_ENV=production                                       (fm-api.service, fm-relay.service)

# API Node — server/prod/http-server.mjs lit HOST/PORT (défaut 127.0.0.1:3000
# si absents, voir DEFAULT_HOST/DEFAULT_PORT dans ce fichier source) : les
# défauts conviennent déjà à la VM, ne les définir que pour les surcharger.
# HOST=127.0.0.1
# PORT=3000


# ════════════════════════════════════════════════════════════
# OPTIONNELLES — dégradation gracieuse si absentes.
# ════════════════════════════════════════════════════════════

# Rétention du worker radar (défaut 24 si absent).
# RADAR_RAW_RETENTION=24
# RADAR_RASTER_RETENTION=24
# Boucle interne de rafraîchissement du worker, en secondes (0 = désactivée,
# déclencheur externe seulement — voir .github/workflows/radar-refresh.yml).
# RADAR_REFRESH_INTERVAL_SECONDS=300

# Alternative à CRON_SECRET pour /api/fuel-price-series-refresh uniquement
# (non utilisé ici : fm-fuel-series.service réutilise CRON_SECRET).
# FUEL_PRICE_SERIES_REFRESH_SECRET=

# OpenSky Network : trafic aérien civil (obligatoires : sans identifiants, aucune collecte aérienne).
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=

# SNCF — perturbations ferroviaires.
# SNCF_API_KEY=

# NASA FIRMS — foyers d'incendie actifs.
# NASA_FIRMS_API_KEY=
# FIRMS_API_KEY=          # alias legacy, NASA_FIRMS_API_KEY prioritaire

# Copernicus Data Space (CDSE) — imagerie Sentinel-2 NDWI (api/sentinel-ndwi.ts).
# CDSE_ACCESS_TOKEN=
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=

# Copernicus OData API générique (api/copernicus.js) — mêmes credentials CDSE,
# endpoint distinct → variables séparées.
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=

# Cloudflare Radar — anomalies trafic Internet FR.
# CLOUDFLARE_RADAR_TOKEN=

# GIE (AGSI/ALSI) — stockages gaz européens. À créer sur agsi.gie.eu si l'API
# l'exige pour le volume de requêtes de prod.
# GIE_API_KEY=

# Shodan / Censys — exposition cyber (api/_handlers/exposure.js, threats.js).
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=

# Limite d'articles détaillés French Breaches (défaut 80).
# FRENCH_BREACHES_DETAIL_LIMIT=80

# Proxy Scrapling (bypass Cloudflare pour quelques flux RSS PQR) — sidecar
# Python NON déployé par cette migration (services/scrapling-proxy/, hors
# spec deploy/oracle). Laisser vide : French Breaches et les flux concernés
# se dégradent gracieusement (fetch direct, éventuel échec silencieux).
# SCRAPLING_PROXY_URL=


# ════════════════════════════════════════════════════════════
# IA / NLP — optionnelles, jamais de préfixe VITE_ côté serveur.
# ════════════════════════════════════════════════════════════

# Groq — résumés, brief, reclassification cron (api/intelligence/v1/*).
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b        # défaut brief/synthèse
# GROQ_FAST_MODEL=openai/gpt-oss-20b    # défaut résumés/reclassification cron

# TypeSafe (Jev) — scoring "System One" des news (cron d'ingestion uniquement).
# TYPESAFE_API_KEY=
# NEWS_SCORING=off        # off (défaut) | shadow | jev
# JEV_BUDGET_PER_TICK=200
