[Unit]
Description=France Monitor - API Node (server/prod/http-server.mjs)
Documentation=https://github.com/FraidFraid/France-Monitor/blob/main/docs/deployment-oracle.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fm
Group=fm
WorkingDirectory=/srv/francemonitor/current
EnvironmentFile=/etc/francemonitor/francemonitor.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/prod/http-server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Durcissement raisonnable : service essentiellement réseau (Upstash/Neon distants) ;
# la seule écriture locale est le registre d'anticipation (journal et archive des signaux).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# Registre d'anticipation (04/11/2026) : seul dossier inscriptible, à créer avant le démarrage (voir docs/deployment-oracle.md).
ReadWritePaths=/var/lib/francemonitor/data/anticipation

[Install]
WantedBy=multi-user.target
