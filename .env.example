# ============================================================
# France Monitor — Variables d'environnement
# Copier vers .env.local pour le dev local.
# Sur Vercel : configurer dans Settings > Environment Variables.
# ============================================================


# ────────────────────────────────────────────────────────────
# OBLIGATOIRES — L'app ne démarre pas sans ces valeurs.
# ────────────────────────────────────────────────────────────

# Upstash Redis — cache serverless inter-users (TTL par route)
# https://console.upstash.com → créer une DB Redis, copier REST URL + token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RTE — Ecowatt (sobriété) + Eco2mix (mix électrique temps réel) + indisponibilités nucléaires
# https://data.rte-france.com → créer une application, obtenir client_id/secret
RTE_CLIENT_ID=
RTE_CLIENT_SECRET=
# RTE_API_VERSION=v7        # défaut: v7 — override version API unavailability_additional_information

# Météo-France — alertes vigilance (API officielle)
# Clé SERVEUR : lue par api/weather/vigilance.js (header `apikey` ajouté côté serveur).
# Le client appelle /api/weather/vigilance sans clé.
# https://portail-api.meteofrance.fr → souscrire "Bulletin Vigilance" (gratuit)
METEO_FRANCE_API_KEY=

# Radar Météo-France DPRadar — worker serveur uniquement (jamais de préfixe VITE_)
# Jeton d'accès au portail API pour le produit IMFR27_C_LFPW.
METEO_FRANCE_RADAR_API_KEY=
# Secret partagé exigé par POST /refresh (Authorization: Bearer ...).
RADAR_WORKER_TOKEN=
# Répertoire persistant où le worker publie latest.webp et manifest.json.
RADAR_STORAGE_DIR=./data/radar
# Origine publique stable utilisée dans imageUrl du manifeste.
RADAR_PUBLIC_BASE_URL=http://localhost:8091
# URL exacte du manifeste public consommé par FranceMonitor (proxy same-origin).
# HTTPS obligatoire hors localhost. Exemple : https://radar.example.fr/manifest.json
METEO_FRANCE_RADAR_MANIFEST_URL=
# Nombre maximal de BUFR radar validés conservés
RADAR_RAW_RETENTION=24
# Nombre maximal de rasters radar conservés (le raster courant est toujours protégé)
RADAR_RASTER_RETENTION=24
# VITE_METEOFRANCE_API_KEY=   # DÉPRÉCIÉ côté client — n'est plus inlinée dans le bundle.
#                             # Encore lue en fallback par la fonction serveur (compat env Vercel existant).

# Marketstack — non requis actuellement pour les cotations boursières.
# Le flux `finance/market` utilise Boursorama en scraping côté proxy / serverless.


# ────────────────────────────────────────────────────────────
# SOURCES DE DONNÉES — Optionnelles, fallback/mock si absentes.
# ────────────────────────────────────────────────────────────

# TomTom — trafic routier temps réel (incidents, flow segment, tuiles raster)
# Clé SERVEUR : lue par api/traffic/{road,flow,tile}.js. Plus AUCUNE clé côté client.
# https://developer.tomtom.com → plan gratuit : 2 500 req/jour
TOMTOM_API_KEY=
# VITE_TOMTOM_API_KEY=     # DÉPRÉCIÉ côté client — n'est plus inlinée dans le bundle.
#                          # Encore lue en fallback par les fonctions serveur (compat env Vercel existant).

# OpenSky Network — trafic aérien civil
# Sans clé : quota très limité (400 req/jour anonyme).
# https://opensky-network.org → créer un compte gratuit
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Relais trafic aérien ADS-B — WebSocket serverless (api/_shared/air-relay.js)
# Pointer vers un relais auto-hébergé ou un agrégateur ADS-B public.
# AIR_RELAY_URL prend le dessus sur WS_RELAY_URL.
# AIR_RELAY_URL=
# WS_RELAY_URL=

# AIS Maritime — relais WebSocket local ou public (layer maritime live)
# En dev, ws://localhost:8090 est utilisé par défaut si non défini.
# En prod sans cette variable, le layer maritime est silencieusement désactivé.
# VITE_AIS_RELAY_URL=

# AISStream.io — alternative cloud au relais AIS local (layer maritime)
# DEV UNIQUEMENT : lue seulement quand import.meta.env.DEV est vrai, jamais inlinée
# dans un build de prod. En prod, utiliser VITE_AIS_RELAY_URL (relais WebSocket).
# https://aisstream.io → clé gratuite, couverture mondiale
# VITE_AISSTREAM_KEY=

# SNCF — perturbations ferroviaires temps réel
# https://numerique.sncf.com/startup/api → accès libre sur demande
SNCF_API_KEY=

# NASA FIRMS — foyers d'incendie actifs (layer feux)
# https://firms.modaps.eosdis.nasa.gov/api → clé gratuite
NASA_FIRMS_API_KEY=
# FIRMS_API_KEY=           # alias legacy, NASA_FIRMS_API_KEY a la priorité

# Copernicus Data Space (CDSE) — imagerie satellite Sentinel-2 NDWI
# Option A (préféré en prod) : injecter un token court-vivant
# CDSE_ACCESS_TOKEN=
# Option B : credentials OAuth client_credentials (token généré à la volée)
# https://dataspace.copernicus.eu → créer un compte, puis OAuth client
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=

# Copernicus OData API — données satellite génériques (api/copernicus.js)
# Mêmes credentials CDSE, mais endpoint distinct → variables séparées.
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=

# Cloudflare Radar — anomalies trafic Internet FR (optionnel)
# https://dash.cloudflare.com/profile/api-tokens → scope Radar:Read
CLOUDFLARE_RADAR_TOKEN=


# ────────────────────────────────────────────────────────────
# IA / NLP — Résumés et classification LLM.
# ────────────────────────────────────────────────────────────

# Groq — fallback IA cloud (SERVEUR UNIQUEMENT : api/intelligence/v1/*)
# NE JAMAIS définir VITE_GROQ_API_KEY — la clé serait exposée dans le bundle JS.
# La summarization passe par /api/intelligence/v1/summarize (proxy serveur).
# https://console.groq.com → clé gratuite
GROQ_API_KEY=

# Ollama — LLM local (aucune clé nécessaire)
# VITE_OLLAMA_URL=         # défaut : http://localhost:11434/api/generate
# VITE_USE_OLLAMA=true     # forcer Ollama même si Groq est configuré


# ────────────────────────────────────────────────────────────
# FEATURE FLAGS — Layers/panels désactivés par défaut.
# Décommenter pour activer.
# ────────────────────────────────────────────────────────────

# VITE_ENABLE_CYBER_PANEL=true
# VITE_ENABLE_GAS_PANEL=true
# VITE_ENABLE_OIL_LAYER=true


# ────────────────────────────────────────────────────────────
# DEV UNIQUEMENT — Ne pas définir en production.
# ────────────────────────────────────────────────────────────

# Scrapling Proxy — bypass Cloudflare pour quelques flux RSS PQR
# Activer seulement si tu lances `npm run dev:full` (port 8080)
# VITE_USE_LOCAL_RSS_PROXY=true
# VITE_SCRAPLING_PROXY_URL=http://localhost:8080
