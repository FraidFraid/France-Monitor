# === Obligatoire ===
# Upstash Redis (cache serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RTE (Ecowatt / Eco2mix)
RTE_CLIENT_ID=
RTE_CLIENT_SECRET=

# Météo-France (vigilance API)
# 1. Créer un compte sur https://portail-api.meteofrance.fr/
# 2. Souscrire à l'API "Bulletin Vigilance" (gratuit)
# 3. Copier l'API key de ton application
VITE_METEOFRANCE_API_KEY=

# === Optionnel ===
# OpenSky Network (trafic aérien civil)
# Recommandé pour de meilleurs quotas et une source primaire stable
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# SNCF
SNCF_API_KEY=

# Groq (fallback IA cloud)
GROQ_API_KEY=

# Cloudflare Radar (anomalies trafic FR — optionnel)
# https://dash.cloudflare.com/profile/api-tokens → Radar:Read
CLOUDFLARE_RADAR_TOKEN=

# Ollama (local, pas besoin de clé)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral:instruct

# Scrapling Proxy (optionnel, pour quelques flux RSS protégés par Cloudflare)
# Activer seulement si tu lances `npm run dev:full`
# VITE_USE_LOCAL_RSS_PROXY=true
# VITE_SCRAPLING_PROXY_URL=http://localhost:8080
